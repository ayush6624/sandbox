EDGE_LISTEN=:443
EDGE_HTTP_LISTEN=:80
EDGE_METRICS_LISTEN=127.0.0.1:9091
EDGE_DOMAIN=sb.example.com
EDGE_CERT_FILE=/var/lib/sandbox-edge/tls/fullchain.pem
EDGE_KEY_FILE=/var/lib/sandbox-edge/tls/privkey.pem
EDGE_GATEWAY=http://10.0.0.2:9090
EDGE_GATEWAY_TOKEN=replace-me
EDGE_RAW_LISTEN_IP=0.0.0.0
EDGE_RAW_PORT_MIN=20000
EDGE_RAW_PORT_MAX=29999
EDGE_DRAIN_TIMEOUT=5m
EDGE_MAX_CONNECTIONS=100000
