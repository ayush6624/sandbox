{
  "socket_path":     "/run/sandbox.sock",
  "db_path":         "/var/lib/sandbox/registry.db",
  "rootfs_base":     "/mnt/sandbox-data/base/devbox-rootfs.ext4",
  "rootfs_dir":      "/mnt/sandbox-data/rootfs",
  "snapshot_dir":    "/mnt/sandbox-data/snapshots",
  "snapshot_bucket": "ratio-experiments-sandbox-snapshots",
  "bridge":          "br-fc",
  "gateway_ip":      "172.16.0.1",
  "allow_inter_guest_network": false,
  "nameservers":     "8.8.8.8,8.8.4.4",
  "firecracker_bin": "/usr/local/bin/firecracker",
  "vm_isolation":    "jailer",
  "jailer_bin":      "/usr/local/bin/jailer",
  "jailer_chroot_base": "/mnt/sandbox-data/jailer",
  "jailer_uid_start": 200000,
  "jailer_gid_start": 200000,
  "jailer_identity_count": 4096,
  "jailer_memory_overhead_mib": 156,
  "jailer_pids_max": 64,
  "jailer_cpu_weight": 100,
  "jailer_cpu_period_us": 100000,
  "jailer_io_read_bps": 268435456,
  "jailer_io_write_bps": 268435456,
  "jailer_no_file": 256,
  "jailer_file_size": 68719476736,
  "disable_seccomp": false,
  "firecracker_log_max_bytes": 16777216,
  "firecracker_log_retention_hours": 24,
  "firecracker_log_max_files": 128,
  "kernel_image":    "/opt/fc/vmlinux",
  "kernel_args":     "reboot=k panic=1 pci=off root=/dev/vda rw console=ttyS0",
  "vcpus":           2,
  "mem_mib":         1024,
  "warm_pool_size":  8,
  "hibernate_after_sec": 600,
  "metrics_guest_stats": true,
  "uffd_restore": false,
  "uffd_chunk_gcs": true,
  "uffd_chunk_prefetch": 32,
  "pools": {
    "TapPrefix":  "fc",
    "TapMax":     48,
    "GuestIPMin": "172.16.0.10",
    "GuestIPMax": "172.16.0.57",
    "PortMin":    5200,
    "PortMax":    5391
  }
}
