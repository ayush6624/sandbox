{
  "name": "sandbox",
  "version": "1.0.0",
  "description": "TypeScript SDK for the sandbox Firecracker microVM sandbox API. Mirrors the e2b JavaScript SDK surface.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sandboxApiVersion": "v1",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ayush6624/sandbox.git",
    "directory": "sdk/typescript"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../../api/openapi.yaml -o src/generated/api-v1.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- src/generated/api-v1.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/demo.ts",
    "example:streaming": "tsx examples/streaming.ts",
    "example:ports": "tsx examples/ports.ts",
    "example:lifecycle": "tsx examples/lifecycle.ts",
    "example:speed": "tsx examples/speed.ts",
    "example:create-many": "tsx examples/create-many.ts",
    "example:fanout": "tsx examples/fanout.ts",
    "bench": "tsx benchmarks/run-bench.ts",
    "bench:snapshot-source": "tsx benchmarks/snapshot-source-bench.ts",
    "bench:snapshot-batch": "tsx benchmarks/snapshot-batch-bench.ts",
    "bench:burst": "tsx benchmarks/burst-bench.ts",
    "bench:fleet": "tsx benchmarks/fleet-bench.ts",
    "bench:lifecycle": "tsx benchmarks/lifecycle-bench.ts",
    "bench:restore": "tsx benchmarks/restore-bench.ts",
    "bench:fanout": "tsx benchmarks/fanout-bench.ts",
    "test": "tsx --test test/smoke.test.ts test/pty.test.ts test/v1.test.ts benchmarks/metadata.test.ts benchmarks/fleet-bench.test.ts benchmarks/snapshot-batch-bench.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
