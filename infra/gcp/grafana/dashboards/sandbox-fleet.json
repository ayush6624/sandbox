{
  "uid": "sandbox-fleet",
  "title": "Sandbox Fleet",
  "description": "Fleet-wide production health: control plane, placement capacity, gateway-owned scaling and drain, rollout safety, and public ingress. Sandbox-level detail is on Sandbox Workload; per-worker detail is on Sandbox Hosts.",
  "tags": ["sandbox", "fleet", "autoscaling"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 6,
  "editable": true,
  "refresh": "10s",
  "links": [
    {
      "type": "dashboards",
      "title": "Sandbox dashboards",
      "tags": ["sandbox"],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "url": "",
      "tooltip": ""
    }
  ],
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"],
    "time_options": ["15m", "1h", "3h", "6h", "12h", "24h", "2d", "7d"]
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Worker",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
        "query": { "query": "label_values(sandbox_host_scrape_ok{job=\"sandbox-hosts\"}, host)", "refId": "VariableQuery" },
        "definition": "label_values(sandbox_host_scrape_ok{job=\"sandbox-hosts\"}, host)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row", "title": "Operational overview", "id": 100,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false
    },
    {
      "type": "stat", "title": "Gateway healthy", "id": 1,
      "description": "Prometheus scrape health for the production API gateway. No data is not healthy.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "min(up{job=\"sandbox-gateway\"})" }]
    },
    {
      "type": "stat", "title": "Healthy edge replicas", "id": 2,
      "description": "Public ingress replicas currently scrapeable by Prometheus. Production quorum is two.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": { "defaults": { "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 1 }, { "color": "green", "value": 2 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "sum(up{job=\"sandbox-edge\"})" }]
    },
    {
      "type": "stat", "title": "Running sandboxes", "id": 3,
      "description": "Fleet-aggregate running user sandboxes reported to the gateway by live workers.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "sandbox_slots_used{job=\"sandbox-gateway\"}" }]
    },
    {
      "type": "stat", "title": "Hibernated sandboxes", "id": 4,
      "description": "Durable idle sandboxes frozen to disk. They hold no running slot but remain inventory and fleet-sizing demand.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "sandbox_hibernated{job=\"sandbox-gateway\"}" }]
    },
    {
      "type": "stat", "title": "Allocatable slots", "id": 5,
      "description": "Capacity the gateway can place against now after readiness, release, drain, memory, and in-flight reservation gates.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 1 }, { "color": "green", "value": 24 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "sandbox_slots_free{job=\"sandbox-gateway\"}" }]
    },
    {
      "type": "stat", "title": "Capacity rejects (5m)", "id": 6,
      "description": "Creates rejected because the bounded queue filled or wait expired. Retrying clients can increment this more than once.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "sum(increase(sandbox_create_rejected_total{job=\"sandbox-gateway\"}[5m]))" }]
    },

    {
      "type": "row", "title": "Sandbox workload & lifecycle", "id": 101,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "collapsed": false
    },
    {
      "type": "timeseries", "title": "Sandbox inventory", "id": 7,
      "description": "User-visible running and hibernated inventory plus transient worker lifecycle states. Warm series are hidden ready-pool inventory, not user sandboxes.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0, "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 12 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sandbox_slots_used{job=\"sandbox-gateway\"}", "legendFormat": "running" },
        { "refId": "B", "expr": "sandbox_hibernated{job=\"sandbox-gateway\"}", "legendFormat": "hibernated" },
        { "refId": "C", "expr": "sum(sandbox_starting{job=\"sandbox-hosts\"})", "legendFormat": "starting" },
        { "refId": "D", "expr": "sum(sandbox_stopping{job=\"sandbox-hosts\"})", "legendFormat": "stopping" },
        { "refId": "E", "expr": "sum(sandbox_warming{job=\"sandbox-hosts\"})", "legendFormat": "warm ready" },
        { "refId": "F", "expr": "sum(sandbox_warm_preparing{job=\"sandbox-hosts\"})", "legendFormat": "warm preparing" }
      ]
    },
    {
      "type": "timeseries", "title": "Create outcomes (events/min)", "id": 8,
      "description": "Gateway successes are the fleet-level completion count. Worker bring-up errors and capacity rejections are separate failure modes; retrying clients can re-increment rejections.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "fieldConfig": { "defaults": { "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(sandbox_creates_total{job=\"sandbox-gateway\"}[2m])) * 60", "legendFormat": "creates ok" },
        { "refId": "B", "expr": "sum(rate(sandbox_creates_error_total{job=\"sandbox-hosts\"}[2m])) * 60", "legendFormat": "worker create errors" },
        { "refId": "C", "expr": "sum(rate(sandbox_create_rejected_total{job=\"sandbox-gateway\"}[2m])) * 60", "legendFormat": "capacity rejections" }
      ]
    },
    {
      "type": "timeseries", "title": "Lifecycle and warm-pool events (events/min)", "id": 9,
      "description": "Hibernate/wake covers user sandbox lifecycle. Warm claims/misses/build failures show whether low-latency inventory is serving eligible creates.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "fieldConfig": { "defaults": { "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(sandbox_hibernations_total{job=\"sandbox-hosts\"}[5m])) * 60", "legendFormat": "hibernations" },
        { "refId": "B", "expr": "sum(rate(sandbox_wakes_total{job=\"sandbox-hosts\"}[5m])) * 60", "legendFormat": "wakes" },
        { "refId": "C", "expr": "sum(rate(sandbox_wake_failures_total{job=\"sandbox-hosts\"}[5m])) * 60", "legendFormat": "wake failures" },
        { "refId": "D", "expr": "sum(rate(sandbox_warm_claims_total{job=\"sandbox-hosts\"}[5m])) * 60", "legendFormat": "warm claims" },
        { "refId": "E", "expr": "sum(rate(sandbox_warm_misses_total{job=\"sandbox-hosts\"}[5m])) * 60", "legendFormat": "warm misses" },
        { "refId": "F", "expr": "sum(rate(sandbox_warm_build_failures_total{job=\"sandbox-hosts\"}[5m])) * 60", "legendFormat": "warm build failures" }
      ]
    },
    {
      "type": "timeseries", "title": "Lifecycle work in progress", "id": 10,
      "description": "Point-in-time work across worker federation. Sustained starting or create-inflight pressure explains slow creates; sustained stopping identifies teardown backlog.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(sandbox_starting{job=\"sandbox-hosts\"})", "legendFormat": "starting" },
        { "refId": "B", "expr": "sum(sandbox_stopping{job=\"sandbox-hosts\"})", "legendFormat": "stopping" },
        { "refId": "C", "expr": "sum(sandbox_create_inflight{job=\"sandbox-hosts\"})", "legendFormat": "create inflight" },
        { "refId": "D", "expr": "sum(sandbox_warm_preparing{job=\"sandbox-hosts\"})", "legendFormat": "warm preparing" },
        { "refId": "E", "expr": "sandbox_warm_ready{job=\"sandbox-gateway\"}", "legendFormat": "warm ready" }
      ]
    },
    {
      "type": "timeseries", "title": "Routing and usage durability", "id": 11,
      "description": "Routes should track durable sandbox inventory. Open usage intervals accrue with running VMMs. Any sustained unflushed backlog means billing evidence remains only on worker disk and is unsafe to scale in.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sandbox_routes{job=\"sandbox-gateway\"}", "legendFormat": "gateway routes" },
        { "refId": "B", "expr": "sum(sandbox_usage_intervals_open{job=\"sandbox-hosts\"})", "legendFormat": "usage intervals open" },
        { "refId": "C", "expr": "sum(sandbox_usage_unflushed_intervals{job=\"sandbox-hosts\"})", "legendFormat": "usage intervals unflushed" }
      ]
    },

    {
      "type": "row", "title": "Worker capacity & process health", "id": 102,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }, "collapsed": false
    },
    {
      "type": "bargauge", "title": "Sandbox-count utilization by worker", "id": 12,
      "description": "Running sandbox count divided by physical slots from 10s gateway heartbeat data. For large sandboxes, memory admission below is the authoritative per-host saturation view.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "red", "value": 0.95 }] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "sandbox_host_slots_used{job=\"sandbox-gateway\",host=~\"$host\"} / sandbox_host_slots_total{job=\"sandbox-gateway\",host=~\"$host\"}", "legendFormat": "{{host}}" }]
    },
    {
      "type": "bargauge", "title": "Binding pools by worker", "id": 13,
      "description": "Tap/IP track running VMs; port tracks running + hibernated mappings. This identifies the resource preventing placement.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "red", "value": 0.95 }] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "sandbox_pool_used{job=\"sandbox-hosts\",host=~\"$host\"} / sandbox_pool_total{job=\"sandbox-hosts\",host=~\"$host\"}", "legendFormat": "{{host}} / {{pool}}" }]
    },
    {
      "type": "bargauge", "title": "Memory admission by worker", "id": 14,
      "description": "Committed guest memory plus VMM overhead divided by the worker's admission budget. This is the key bin-packing constraint for non-default sandbox sizes.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "red", "value": 0.95 }] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "sandbox_committed_mem_mib{job=\"sandbox-hosts\",host=~\"$host\"} / sandbox_mem_budget_mib{job=\"sandbox-hosts\",host=~\"$host\"}", "legendFormat": "{{host}}" }]
    },
    {
      "type": "timeseries", "title": "Create concurrency saturation", "id": 15,
      "description": "Fleet deploys now default to 24 bring-ups per worker. Sustained saturation explains rising create latency even before capacity is exhausted.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "expr": "sandbox_create_inflight{job=\"sandbox-hosts\",host=~\"$host\"} / sandbox_create_concurrency{job=\"sandbox-hosts\",host=~\"$host\"}", "legendFormat": "{{host}}" }]
    },
    {
      "type": "timeseries", "title": "Guest CPU: consumed vs allocated", "id": 16,
      "description": "Five-minute rate of closed usage intervals. CPU consumed is recorded guest CPU-seconds; allocated is billable vCPU-seconds. Closure timing makes these operational trends, not instantaneous host CPU utilization.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "fieldConfig": { "defaults": { "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(sandbox_cpu_seconds_total{job=\"sandbox-hosts\",host=~\"$host\"}[5m]))", "legendFormat": "guest CPU consumed" },
        { "refId": "B", "expr": "sum(rate(sandbox_billable_vcpu_seconds_total{job=\"sandbox-hosts\",host=~\"$host\"}[5m]))", "legendFormat": "vCPU allocated" }
      ]
    },

    {
      "type": "row", "title": "Capacity scaling & drain mechanics", "id": 107,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 }, "collapsed": false
    },
    {
      "type": "timeseries", "title": "Workers: heartbeat-live vs MIG target", "id": 35,
      "description": "MIG target is authoritative provider intent; heartbeat-live is what the gateway sees. Target above live is boot/readiness lag. Live above target is drain/delete or heartbeat-TTL lag—not extra desired demand. Provider standby must remain MANUAL with zero suspended/stopped targets.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0, "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 12 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sandbox_hosts_live{job=\"sandbox-gateway\"}", "legendFormat": "heartbeat-live" },
        { "refId": "B", "expr": "sandbox:workers_desired", "legendFormat": "MIG target" },
        { "refId": "C", "expr": "sandbox_scale_out_requested{job=\"sandbox-gateway\"}", "legendFormat": "scale-out watermark" }
      ]
    },
    {
      "type": "timeseries", "title": "Memory-weighted demand vs capacity", "id": 36,
      "description": "Default-slot equivalents used by fleet sizing. Demand includes memory weighting; total is registered host capacity; allocatable is placement-ready capacity after gates and reservations.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "fieldConfig": { "defaults": { "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sandbox_slots_total{job=\"sandbox-gateway\"}", "legendFormat": "registered capacity" },
        { "refId": "B", "expr": "sandbox_slots_demand{job=\"sandbox-gateway\"}", "legendFormat": "committed demand" },
        { "refId": "C", "expr": "sandbox_create_queue_demand_slots{job=\"sandbox-gateway\"}", "legendFormat": "queued demand" },
        { "refId": "D", "expr": "sandbox_slots_free{job=\"sandbox-gateway\"}", "legendFormat": "allocatable now" }
      ]
    },
    {
      "type": "timeseries", "title": "Create queue", "id": 37,
      "description": "Queue depth counts requests; queued demand uses memory-weighted default-slot units. Divergence identifies larger sandbox shapes. Capacity rejections show client impact after the queue cannot absorb demand.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "fieldConfig": { "defaults": { "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 12 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sandbox_create_queue_depth{job=\"sandbox-gateway\"}", "legendFormat": "queued requests" },
        { "refId": "B", "expr": "sandbox_create_queue_demand_slots{job=\"sandbox-gateway\"}", "legendFormat": "queued demand units" },
        { "refId": "C", "expr": "sum(rate(sandbox_create_rejected_total{job=\"sandbox-gateway\"}[2m])) * 60", "legendFormat": "rejections/min" }
      ]
    },
    {
      "type": "timeseries", "title": "Gateway scale-out actions", "id": 38,
      "description": "The gateway is the only MIG writer. Requests should correlate with queued weighted demand; any failed provider request is actionable.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "fieldConfig": { "defaults": { "min": 0, "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 30 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(increase(sandbox_direct_scale_out_total{job=\"sandbox-gateway\"}[$__rate_interval]))", "legendFormat": "requests" },
        { "refId": "B", "expr": "sum(increase(sandbox_direct_scale_out_failed_total{job=\"sandbox-gateway\"}[$__rate_interval]))", "legendFormat": "failed" }
      ]
    },
    {
      "type": "timeseries", "title": "Scale-in drain safety", "id": 39,
      "description": "Draining hosts are cordoned and continue serving their sandboxes. Cordons should resolve as removed or aborted. Deletion failures leave a host cordoned for retry and require investigation if persistent.",
      "datasource": { "type": "prometheus", "uid": "sandbox-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "fieldConfig": { "defaults": { "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
