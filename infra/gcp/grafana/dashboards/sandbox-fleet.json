      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "expr": "sandbox_worker_ready_seconds{job=\"sandbox-hosts\",host=~\"$host\"}", "legendFormat": "{{host}}" }]
