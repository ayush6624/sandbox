        { "refId": "B", "expr": "sum(rate(sandbox_edge_bytes_total{job=\"sandbox-edge\",dir=\"guest_to_client\"}[5m]))", "legendFormat": "HTTPS guest → client" },
        { "refId": "C", "expr": "sum(rate(sandbox_edge_raw_bytes_total{job=\"sandbox-edge\",dir=\"client_to_guest\"}[5m]))", "legendFormat": "raw client → guest" },
        { "refId": "D", "expr": "sum(rate(sandbox_edge_raw_bytes_total{job=\"sandbox-edge\",dir=\"guest_to_client\"}[5m]))", "legendFormat": "raw guest → client" }
      ]
    },
    {
      "type": "timeseries", "title": "Ingress routing, TLS, and rate-limit errors", "id": 41,
      "description": "Events per minute that explain ingress failures before or while reaching a sandbox. Miss/stale/unknown are shown separately from TLS and source-rate limiting.",
