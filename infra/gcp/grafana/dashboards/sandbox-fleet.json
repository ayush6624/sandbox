      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sandbox_raw_leases{job=\"sandbox-gateway\",state=\"active\"}", "legendFormat": "active" },
        { "refId": "B", "expr": "sandbox_raw_leases{job=\"sandbox-gateway\",state=\"pending\"}", "legendFormat": "pending" },
        { "refId": "C", "expr": "sandbox_raw_leases{job=\"sandbox-gateway\",state=\"releasing\"}", "legendFormat": "releasing" },
